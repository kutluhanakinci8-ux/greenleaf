{
  "name": "greenleaf-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Greenleaf — Windows yerel POS (veri PCde)",
  "type": "module",
  "scripts": {
    "greenleaf:dev": "npm run build && node scripts/greenleaf-start.mjs",
    "greenleaf:start": "node scripts/greenleaf-start.mjs",
    "dev": "vite --port 5190",
    "build": "npm run windows:receipt-install:sync && tsc -b && vite build",
    "windows:receipt-install:sync": "node scripts/sync-windows-receipt-install-public.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5190",
    "start": "node scripts/greenleaf-start.mjs",
    "test": "node scripts/run-unit-tests.mjs"
  },
  "dependencies": {
    "imapflow": "^1.7.8",
    "nodemailer": "^10.0.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.2",
    "undici": "^6.29.0"
  }
}
