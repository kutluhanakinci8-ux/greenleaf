# Greenleaf POS — ortam değişkenleri (örnek)
# Kopyalayın: cp .env.example .env

# HTTP
PORT=5190
HOST=0.0.0.0
GREENLEAF_PUBLIC_ORIGIN=http://127.0.0.1:5190

# Veri klasörü (Windows: %ProgramData%\GreenleafPOS\data)
# MARKET_POS_DATA_DIR=./data

# Giden e-posta (SMTP)
# GREENLEAF_SMTP_HOST=mail.example.com
# GREENLEAF_SMTP_PORT=587
# GREENLEAF_SMTP_USER=
# GREENLEAF_SMTP_PASS=
# GREENLEAF_MAIL_FROM=notifications@example.com
# GREENLEAF_MAIL_FROM_NAME=Greenleaf POS
# GREENLEAF_MAIL_REPLY_TO=support@example.com
# GREENLEAF_OPS_EMAIL=support@example.com

# Gelen posta (IMAP, isteğe bağlı)
# GREENLEAF_IMAP_HOST=imap.example.com
# GREENLEAF_IMAP_PORT=993
# GREENLEAF_IMAP_USER=
# GREENLEAF_IMAP_PASS=

# POS API (mobil / entegrasyon)
# GREENLEAF_POS_API_SECRET=

# Masaüstü kurulum
# GREENLEAF_DESKTOP=1
# GREENLEAF_OWNER_RECOVERY_EMAIL=owner@example.com
